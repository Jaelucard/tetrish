# sample.tetrishrc - tetriSH configuration contract
# Copy to .tetrishrc and edit. All daemons read this at startup.
# Format: key<whitespace>value   # comment runs to end of line
#         blank lines ignored, unknown keys warn + ignored, last duplicate wins
#         relative paths resolve against the project root

# ---------REQUIRED----------(daemon refuses to start if any are missing)
listen_port    7777                          # tetrisd TCP listen port
cert_path      auth/server.crt               # server X.509 cert (sent in handshake)
key_path       auth/server.key               # server private key (RSA-PSS sign / OAEP)
ca_path        auth/cacsertificate.crt       # CA bundle clients verify the cert against
log_path       var/log/tetrisd.log           # where tetrislogd writes records
log_ipc        var/run/tetrislogd.sock       # AF_UNIX DGRAM: tetrisd -> tetrislogd
ctl_path       var/run/tetrisctl.sock        # AF_UNIX STREAM: tetrisctl -> tetrisd

# ----------OPERATIONAL----------(optional: parser prefills defaults)
daemonize      no                            # toggle the double-fork instead of compiling it in
pid_path       var/run/tetrisd.pid           # configurable PID file path, not hard-coded
bind           127.0.0.1                     # interface to listen on; loopback-only default
tcp_backlog    128                           # listen() backlog depth
tcp_keepalive  120                           # SO_KEEPALIVE secs; detects half-dead clients
ctl_perm       0700                          # octal perms on ctl_path socket, enforced via umask around bind() (parse base 8!)

# Per-IP connection cap, ENFORCED at accept() before the handshake runs. The
# ordering matters: the handshake costs an RSA signature, so a connect flood
# from one host would be cheap to send and expensive to serve. Rejections are
# logged at warn level and counted in `tetrisctl status` as rejected_conns.
# Set to 0 to disable, which is what you want for a local stress test where
# every connection legitimately comes from 127.0.0.1.
max_conns_per_ip 8                           # 0 = unlimited                     [issue #7/#11]

# How many parked connections tetrisd completes the handshake for on each pass
# of its event loop. The handshake costs an RSA operation, so doing them all on
# demand froze the loop for seconds when a crowd arrived. Rationing them keeps
# existing games ticking while a burst is let in. Measured with 500 clients
# connecting at once: a budget of 4 admitted 394 of them, 16 admitted 470, and
# 32 admitted all 500 at a cost of about 3% on the tick rate during the burst.
handshake_budget 32

# ----------PLANNED (post-gate)----------(parsed + stored, NOT yet enforced)
client_timeout 60                            # close idle client after N secs   [issue #10]
max_clients    64                            # sizes the fd limit only; per-IP cap above is the enforced admission bound

# --------GAME----------(optional tunables)
tick_hz              20                       # game ticks/sec
log_level            info                     # debug | info | warn | error
snapshot_interval    60                       # ticks between SNAPSHOT log records
max_rooms            16                       # max concurrent rooms
max_players_per_room 6                        # cap per room
garbage_mq           /tetrish-garbage         # POSIX mq name, Battle Royale garbage channel (must start with /)

# ----------DEMO----------(uncomment, or type these at the tetrish prompt)
# tetrish executes non-directive lines as commands when it sources this file,
# so uncommenting these brings the whole system up from `./bin/tetrish` alone.
# (The daemons warn `unknown key 'dspawn'` and ignore the lines - see README
# known limitation 12.)
# dspawn bin/tetrislogd .tetrishrc
# dspawn bin/tetrisd    .tetrishrc
